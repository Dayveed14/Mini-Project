# Copy this file to .env and fill it in. Never commit .env.

# Public URL of the /public folder, no trailing slash.
#   XAMPP without a virtual host: http://localhost/uniuyo-dues/public
#   Production:                   https://dues.example.edu.ng
APP_URL=http://localhost/uniuyo-dues/public
APP_ENV=local            # local | production  (production hides errors, forces secure cookies)
APP_NAME="UniUyo Dues"

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uniuyo_dues
DB_USER=root
DB_PASS=

# Paystack — https://dashboard.paystack.com/#/settings/developers
# Use sk_test_ keys until you go live. The secret key also signs webhooks.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Shared secret for the SMS Enabler endpoint. Put it in the SMS-to-Webserver URL:
#   https://your-site/sms.php?token=THIS_VALUE
# Generate one with:  php -r "echo bin2hex(random_bytes(24));"
SMS_WEBHOOK_TOKEN=replace_with_a_long_random_string

# Optional: name shown to students as the payee.
PAYEE_NAME="University of Uyo Students' Union"

# Optional: the phone number SMS Enabler receives texts on, shown to students.
SMS_NUMBER=
