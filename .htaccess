# Used when the whole project folder sits inside htdocs (typical XAMPP setup).
# Only /public is meant to be reachable; everything else is denied.
Options -Indexes

<FilesMatch "^\.|\.(sql|md|log|lock|json)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteCond %{REQUEST_URI} !/public/
RewriteRule ^(.*)$ public/$1 [L]
